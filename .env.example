# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Authentication & Security
AUTH_SECRET="replace-with-secure-random-secret-key"

# Payment Provider Configuration (mock | paystack)
# Default is "mock" so the application works out-of-the-box without Paystack credentials
PAYMENT_PROVIDER="mock"
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# Notification Provider Configuration (in_app | email | sms | whatsapp)
NOTIFICATION_PROVIDER="in_app"
SMS_API_KEY=""
WHATSAPP_API_KEY=""
EMAIL_API_KEY=""

